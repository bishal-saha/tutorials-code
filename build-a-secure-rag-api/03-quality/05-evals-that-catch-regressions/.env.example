# The app connects as rag_app: not the table owner, no BYPASSRLS, so row-level security applies.
DATABASE_URL=postgres://rag_app:rag_app@localhost:5433/rag
# The trusted ingest job connects as rag_ingest, which may write any tenant's rows.
DATABASE_URL_INGEST=postgres://rag_ingest:rag_ingest@localhost:5433/rag
# Only migrations use the superuser.
DATABASE_URL_ADMIN=postgres://rag:rag@localhost:5433/rag
EMBEDDINGS_PROVIDER=fake
EMBEDDINGS_DIMENSIONS=256
LLM_PROVIDER=fake
# Local development signs test tokens with a shared secret. In production, verify against
# your identity provider's JWKS instead (see src/auth.js).
JWT_SECRET=change-me-to-a-long-random-string
JWT_ISSUER=https://auth.example.test
JWT_AUDIENCE=support-assistant
PORT=3000
